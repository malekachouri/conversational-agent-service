# Copy to .env and fill in. docker-compose reads this file automatically.

# Claude API key (https://console.anthropic.com). Required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# SQLAlchemy URL. Defaults to a local SQLite file when unset.
# docker-compose overrides this to point at its Postgres container.
DATABASE_URL=sqlite:///dev.db
# DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent

# Optional
# LLM_PROVIDER=anthropic        # or "mock" for a deterministic offline stand-in
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium       # low | medium | high | xhigh | max
